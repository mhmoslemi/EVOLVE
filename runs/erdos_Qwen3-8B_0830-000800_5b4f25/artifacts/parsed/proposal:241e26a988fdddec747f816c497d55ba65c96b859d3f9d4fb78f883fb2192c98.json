  "source_text": "```python\nimport numpy as np\nimport scipy.optimize as optimize\nfrom scipy.signal import correlate\nimport time\n\ndef run(seed=42, budget_s=100, **kwargs):\n    np.random.seed(seed)\n    start_time = time.time()\n    \n    # Initial values from the provided construction\n    initial_h_values = np.array([0.18463107836353193, 0.3409054485290476, 0.6203300295910438,\n                                 0.8700723704256288, 0.19080707334515862, 0.6262334571765071,\n                                 0.7433070409735469, 0.5320044534767051, 0.7216558187241402,\n                                 0.8272428258791049, 0.5221669572588927, 0.7587737367565517,\n                                 0.1669874751571035, 0.7071369895059625, 0.7411718298101755,\n                                 0.17602559194193396, 0.20689697302085464, 0.43492537257696057,\n                                 0.38372059581690526, 0.32419774586298217, 0.7971915035227723,\n                                 0.12850681338277214, 0.26773169716155504, 0.633484465697802,\n                                 0.5058525103424685, 0.5237621128636435, 0.6676059101179728,\n                                 0.16728198516241194, 0.7099110744861223, 0.6454977381300697,\n                                 0.8428511110541352, 0.6204112730627964, 0.9161287747314493,\n                                 0.5206644547861512, 0.6993059988228139, 0.1573260492059893,\n                                 0.33038023294168106, 0.2612644616004159, 0.5590106170254208,\n                                 0.4814006621790201, 0.2770893017132045, 0.4937777804714631,\n                                 0.22840152535856967, 0.4838534765842302, 0.8882480271862889,\n                                 0.5315789084504143, 0.4823592091619433, 0.5101024954639957,\n                                 0.3207933561708651, 0.5841349247847331, 0.24937417345258767,\n                                 0.20271989872105023, 0.515732196702088, 0.2296044807169076,\n                                 0.6650001822991272, 0.6155348920298767, 0.4954794856311117,\n                                 0.2839893421829861, 0.4440398957498207, 0.8782629119704282,\n                                 0.6726091834552566, 0.7713483009303264, 0.2437587655505743,\n                                 0.898352134416883, 0.4124840624025352, 0.4231817003538969,\n                                 0.42561542199982016, 0.20243829252813417, 0.7182178276907307,\n                                 0.3371555353999507])\n    n_points = len(initial_h_values)\n    dx = 2.0 / n_points\n    h = initial_h_values.copy()\n    \n    def evaluate_c5(h_values):\n        h_array = np.array(h_values)\n        h_array = np.concatenate((h_array, h_array[:1]))  # To handle wrap-around\n        corr = correlate(h_array, 1 - h_array, mode=\"full\")\n        c5 = np.max(corr * dx)\n        return c5\n    \n    def objective(x):\n        h = x.copy()\n        h = np.clip(h, 0, 1)\n        return evaluate_c5(h)\n    \n    def constraint_sum(x):\n        return np.sum(x) - n_points / 2\n    \n    # Optimization using the L-BFGS-B algorithm\n    bounds = [(0, 1) for _ in range(n_points)]\n    cons = [{'type': 'eq', 'fun': constraint_sum}]\n    result = optimize.minimize(objective, h, bounds=bounds, constraints=cons, method='L-BFGS-B')\n    \n    # Check if we have a better solution\n    best_h = result.x\n    best_c5 = evaluate_c5(best_h)\n    \n    # If we have time, try perturbing the solution slightly to see if we can find a better one\n    if time.time() - start_time < budget_s - 10:\n        perturbation = np.random.uniform(-0.05, 0.05, size=n_points)\n        perturbed_h = np.clip(best_h + perturbation, 0, 1)\n        perturbed_c5 = evaluate_c5(perturbed_h)\n        if perturbed_c5 < best_c5:\n            best_h = perturbed_h\n            best_c5 = perturbed_c5\n    \n    # If the initial solution is better, use that\n    initial_c5 = evaluate_c5(initial_h_values)\n    if initial_c5 < best_c5:\n        best_h = initial_h_values\n        best_c5 = initial_c5\n    \n    return (best_h.tolist(), best_c5, n_points)\n```"
