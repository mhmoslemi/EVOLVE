  "source_text": "```python\nimport numpy as np\nimport scipy.optimize as opt\nimport time\nimport cvxpy as cp\n\ndef run(seed=42, budget_s=100, **kwargs):\n    np.random.seed(seed)\n    \n    # Initial guess from provided initial_h_values\n    initial_h_values = np.array([0.18463107836353193, 0.3409054485290476, 0.6203300295910438, 0.8700723704256288, 0.19080707334515862, 0.6262334571765071, 0.7433070409735469, 0.5320044534767051, 0.7216558187241402, 0.8272428258791049, 0.5221669572588927, 0.7587737367565517, 0.1669874751571035, 0.7071369895059625, 0.7411718298101755, 0.17602559194193396, 0.20689697302085464, 0.43492537257696057, 0.38372059581690526, 0.32419774586298217, 0.7971915035227723, 0.12850681338277214, 0.26773169716155504, 0.633484465697802, 0.5058525103424685, 0.5237621128636435, 0.6676059101179728, 0.16728198516241194, 0.7099110744861223, 0.6454977381300697, 0.8428511110541352, 0.6204112730627964, 0.9161287747314493, 0.5206644547861512, 0.6993059988228139, 0.1573260492059893, 0.33038023294168106, 0.2612644616004159, 0.5590106170254208, 0.4814006621790201, 0.2770893017132045, 0.4937777804714631, 0.22840152535856967, 0.4838534765842302, 0.8882480271862889, 0.5315789084504143, 0.4823592091619433, 0.5101024954639957, 0.3207933561708651, 0.5841349247847331, 0.24937417345258767, 0.20271989872105023, 0.515732196702088, 0.2296044807169076, 0.6650001822991272, 0.6155348920298767, 0.4954794856311117, 0.2839893421829861, 0.4440398957498207, 0.8782629119704282, 0.6726091834552566, 0.7713483009303264, 0.2437587655505743, 0.898352134416883, 0.4124840624025352, 0.4231817003538969, 0.42561542199982016, 0.20243829252813417, 0.7182178276907307, 0.3371555353999507])\n    n_points = len(initial_h_values)\n    dx = 2.0 / n_points\n    sum_h = np.sum(initial_h_values) * dx\n    if np.abs(sum_h - 1.0) > 1e-6:\n        initial_h_values = initial_h_values * (1.0 / sum_h) * dx\n\n    def compute_c5(h):\n        h = np.array(h)\n        h = np.concatenate([h, h[:2]])\n        conv = np.correlate(h, 1 - h, mode=\"full\")\n        conv = conv[:-2]  # Remove the extra elements\n        return np.max(conv * dx)\n\n    def objective(h):\n        return compute_c5(h)\n\n    def constraint_sum(h):\n        return np.sum(h) - n_points / 2\n\n    # Use a gradient-based optimizer with constraints\n    h = cp.Variable(n_points)\n    obj = cp.Minimize(objective(h))\n    constr = [constraint_sum(h) == 0]\n    prob = cp.Problem(obj, constr)\n\n    start_time = time.time()\n    try:\n        result = prob.solve(solver=cp.SCS, max_iter=100, time_limit=budget_s - (time.time() - start_time))\n    except:\n        result = None\n\n    if result is not None and prob.status == 'optimal':\n        h_values = [float(h.value[i]) for i in range(n_points)]\n        c5_bound = compute_c5(h_values)\n    else:\n        # Fallback to a more robust optimization\n        bounds = [(0.0, 1.0) for _ in range(n_points)]\n        constraints = [np.sum(h) == n_points / 2]\n        result = opt.minimize(objective, initial_h_values, method='L-BFGS-B', bounds=bounds, constraints=constraints, tol=1e-8, options={'maxiter': 100, 'disp': False})\n        h_values = result.x\n        c5_bound = compute_c5(h_values)\n\n    elapsed_time = time.time() - start_time\n    if elapsed_time > budget_s - 1e-3:\n        h_values = initial_h_values\n        c5_bound = compute_c5(h_values)\n\n    return h_values, c5_bound, n_points\n```"
