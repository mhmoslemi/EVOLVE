  "source_text": "```python\nimport numpy as np\nimport scipy.optimize as opt\nfrom scipy.optimize import minimize\nfrom scipy.signal import correlate\nimport time\n\ninitial_h_values = [0.18463107836353193, 0.3409054485290476, 0.6203300295910438, 0.8700723704256288, 0.19080707334515862, 0.6262334571765071, 0.7433070409735469, 0.5320044534767051, 0.7216558187241402, 0.8272428258791049, 0.5221669572588927, 0.7587737367565517, 0.1669874751571035, 0.7071369895059625, 0.7411718298101755, 0.17602559194193396, 0.20689697302085464, 0.43492537257696057, 0.38372059581690526, 0.32419774586298217, 0.7971915035227723, 0.12850681338277214, 0.26773169716155504, 0.633484465697802, 0.5058525103424685, 0.5237621128636435, 0.6676059101179728, 0.16728198516241194, 0.7099110744861223, 0.6454977381300697, 0.8428511110541352, 0.6204112730627964, 0.9161287747314493, 0.5206644547861512, 0.6993059988228139, 0.1573260492059893, 0.33038023294168106, 0.2612644616004159, 0.5590106170254208, 0.4814006621790201, 0.2770893017132045, 0.4937777804714631, 0.22840152535856967, 0.4838534765842302, 0.8882480271862889, 0.5315789084504143, 0.4823592091619433, 0.5101024954639957, 0.3207933561708651, 0.5841349247847331, 0.24937417345258767, 0.20271989872105023, 0.515732196702088, 0.2296044807169076, 0.6650001822991272, 0.6155348920298767, 0.4954794856311117, 0.2839893421829861, 0.4440398957498207, 0.8782629119704282, 0.6726091834552566, 0.7713483009303264, 0.2437587655505743, 0.898352134416883, 0.4124840624025352, 0.4231817003538969, 0.42561542199982016, 0.20243829252813417, 0.7182178276907307, 0.3371555353999507]\n\ndef run(seed=42, budget_s=100, **kwargs):\n    np.random.seed(seed)\n    n_points = 100  # fewer points for faster optimization\n    dx = 2.0 / n_points\n    initial_h = np.array(initial_h_values[:n_points])  # Crop initial solution\n    initial_h = initial_h * (n_points / 2) / np.sum(initial_h)  # Normalize to meet the constraint\n\n    def objective_func(h_values):\n        h = h_values.reshape(n_points)\n        # Compute the correlation\n        corr = correlate(h, 1 - h, mode=\"full\")\n        # Compute the max value\n        c5 = np.max(corr) * dx\n        return c5\n\n    def constraint_func(h_values):\n        h = h_values.reshape(n_points)\n        return np.sum(h) - n_points / 2  # Constraint: sum(h) == n_points / 2\n\n    # Define bounds\n    bounds = [(0.0, 1.0) for _ in range(n_points)]\n\n    # Initial guess\n    initial_guess = initial_h\n\n    # Optimization\n    start_time = time.time()\n    result = minimize(objective_func, initial_guess, method='L-BFGS-B', bounds=bounds, constraints=[{'type': 'eq', 'fun': constraint_func}])\n    elapsed_time = time.time() - start_time\n\n    if elapsed_time > budget_s:\n        return (initial_guess, objective_func(initial_guess), n_points)\n\n    h_values = result.x\n    c5_bound = objective_func(h_values)\n\n    return (h_values, c5_bound, n_points)\n```"
