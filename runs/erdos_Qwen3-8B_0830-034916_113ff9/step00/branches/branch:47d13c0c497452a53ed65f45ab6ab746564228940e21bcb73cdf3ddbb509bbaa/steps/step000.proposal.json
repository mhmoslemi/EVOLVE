  "source_text": "```python\nimport numpy as np\nimport scipy.optimize as optimize\nimport time\n\ninitial_h_values = [0.18463107836353193, 0.3409054485290476, 0.6203300295910438, 0.8700723704256288, 0.19080707334515862, 0.6262334571765071, 0.7433070409735469, 0.5320044534767051, 0.7216558187241402, 0.8272428258791049, 0.5221669572588927, 0.7587737367565517, 0.1669874751571035, 0.7071369895059625, 0.7411718298101755, 0.17602559194193396, 0.20689697302085464, 0.43492537257696057, 0.38372059581690526, 0.32419774586298217, 0.7971915035227723, 0.12850681338277214, 0.26773169716155504, 0.633484465697802, 0.5058525103424685, 0.5237621128636435, 0.6676059101179728, 0.16728198516241194, 0.7099110744861223, 0.6454977381300697, 0.8428511110541352, 0.6204112730627964, 0.9161287747314493, 0.5206644547861512, 0.6993059988228139, 0.1573260492059893, 0.33038023294168106, 0.2612644616004159, 0.5590106170254208, 0.4814006621790201, 0.2770893017132045, 0.4937777804714631, 0.22840152535856967, 0.4838534765842302, 0.8882480271862889, 0.5315789084504143, 0.4823592091619433, 0.5101024954639957, 0.3207933561708651, 0.5841349247847331, 0.24937417345258767, 0.20271989872105023, 0.515732196702088, 0.2296044807169076, 0.6650001822991272, 0.6155348920298767, 0.4954794856311117, 0.2839893421829861, 0.4440398957498207, 0.8782629119704282, 0.6726091834552566, 0.7713483009303264, 0.2437587655505743, 0.898352134416883, 0.4124840624025352, 0.4231817003538969, 0.42561542199982016, 0.20243829252813417, 0.7182178276907307, 0.3371555353999507]\n\ndef run(seed=42, budget_s=100, **kwargs):\n    start_time = time.time()\n    np.random.seed(seed)\n\n    n_points = 80  # a moderate number for performance\n    dx = 2.0 / n_points\n    h_initial = np.array(initial_h_values[:n_points]) * (n_points / 2) / np.sum(initial_h_values[:n_points])\n\n    def objective(h):\n        h = np.clip(h, 0, 1)\n        h = h / np.sum(h) * (n_points / 2)\n        corr = np.correlate(h, 1 - h, mode=\"full\")\n        c5 = np.max(corr) * dx\n        return c5\n\n    # Initial guess\n    h0 = h_initial.copy()\n\n    # Optimization with L-BFGS-B\n    result = optimize.minimize(\n        objective,\n        h0,\n        method='L-BFGS-B',\n        bounds=[(0, 1) for _ in range(n_points)],\n        options={'maxiter': 100, 'ftol': 1e-8, 'gtol': 1e-8}\n    )\n\n    # Check if we went over the budget\n    elapsed_time = time.time() - start_time\n    if elapsed_time > budget_s - 1:\n        # If time is up, return the best found solution\n        return (result.x.tolist(), objective(result.x), n_points)\n\n    # If we have time, do a few more iterations with random perturbations\n    for _ in range(5):\n        perturbation = np.random.normal(0, 0.05, n_points)\n        h_candidate = result.x + perturbation\n        h_candidate = np.clip(h_candidate, 0, 1)\n        h_candidate = h_candidate / np.sum(h_candidate) * (n_points / 2)\n        c5_candidate = objective(h_candidate)\n        if c5_candidate < objective(result.x):\n            result = optimize.minimize(\n                objective,\n                h_candidate,\n                method='L-BFGS-B',\n                bounds=[(0, 1) for _ in range(n_points)],\n                options={'maxiter': 50, 'ftol': 1e-8, 'gtol': 1e-8}\n            )\n\n    # Final check for time\n    elapsed_time = time.time() - start_time\n    if elapsed_time > budget_s - 1:\n        return (result.x.tolist(), objective(result.x), n_points)\n\n    return (result.x.tolist(), objective(result.x), n_points)\n```"
